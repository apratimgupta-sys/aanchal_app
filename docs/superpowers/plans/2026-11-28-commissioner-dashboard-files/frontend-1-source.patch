diff --git a/src/domain/daily-entry-order.ts b/src/domain/daily-entry-order.ts
new file mode 100644
index 0000000..3eb9115
--- /dev/null
+++ b/src/domain/daily-entry-order.ts
@@ -0,0 +1,28 @@
+import services from "../shared/services.json" with { type: "json" };
+import { dailyEntryCollects, formShape } from "./service-kind";
+
+// The services the daily entry collects, in the order the entry form lists
+// them: the services that keep a queue first, then the collections, each group
+// in service-master order. The dashboard lists and numbers services the same
+// way, so the Commissioner and the clerk mean the same thing by "service 08".
+//
+// TWIN: the entry form builds the same list for itself (GROUPS and
+// displayNumber in src/client/pages/DailyEntry.tsx). Both are held against the
+// hand-written oracle in tests/ui/service-position.ts.
+const afterTheQueues = (serviceId: number) => (formShape(serviceId) === "revenue" ? 1 : 0);
+
+export const DAILY_SERVICES = services
+  .filter((s) => dailyEntryCollects(s.id))
+  .map((service, index) => ({ service, index }))
+  .sort((a, b) => afterTheQueues(a.service.id) - afterTheQueues(b.service.id) || a.index - b.index)
+  .map((x) => x.service);
+
+const NUMBER = new Map<number, string>(DAILY_SERVICES.map((s, i) => [s.id, String(i + 1).padStart(2, "0")]));
+
+// The service's place in that list as the entry form prints it ("01" to "10").
+// Display only: the id is what is stored and sent.
+export function displayNumber(serviceId: number): string {
+  const number = NUMBER.get(serviceId);
+  if (number === undefined) throw new Error(`Service ${serviceId} is not on the daily entry`);
+  return number;
+}
diff --git a/src/domain/period.ts b/src/domain/period.ts
new file mode 100644
index 0000000..0ee1fd0
--- /dev/null
+++ b/src/domain/period.ts
@@ -0,0 +1,37 @@
+// The periods a dashboard section can be set to, and the dates each one means.
+// Dates are Indian calendar days as "YYYY-MM-DD" strings; the arithmetic is done
+// in UTC on the date alone, so no clock or time zone can shift a day.
+export type PeriodKind = "today" | "week" | "month" | "custom";
+
+export type PeriodValue = { kind: PeriodKind; from: string; to: string };
+
+const DATE = /^\d{4}-\d{2}-\d{2}$/;
+
+export function addDays(date: string, days: number): string {
+  const d = new Date(`${date}T00:00:00Z`);
+  d.setUTCDate(d.getUTCDate() + days);
+  return d.toISOString().slice(0, 10);
+}
+
+// How many days a range covers, both ends included.
+export function daysInRange(from: string, to: string): number {
+  return Math.round((Date.parse(`${to}T00:00:00Z`) - Date.parse(`${from}T00:00:00Z`)) / 86_400_000) + 1;
+}
+
+// The dates a period means today, or null when a custom range cannot be asked
+// for: a date missing or malformed, the start after the end, or the end after
+// today. "week" is today and the six days before it; "month" is the 1st to today.
+export function periodRange(value: PeriodValue, today: string): { from: string; to: string } | null {
+  switch (value.kind) {
+    case "today":
+      return { from: today, to: today };
+    case "week":
+      return { from: addDays(today, -6), to: today };
+    case "month":
+      return { from: `${today.slice(0, 8)}01`, to: today };
+    case "custom":
+      if (!DATE.test(value.from) || !DATE.test(value.to)) return null;
+      if (value.from > value.to || value.to > today) return null;
+      return { from: value.from, to: value.to };
+  }
+}
diff --git a/src/domain/visit-cards.ts b/src/domain/visit-cards.ts
new file mode 100644
index 0000000..f9a3d2d
--- /dev/null
+++ b/src/domain/visit-cards.ts
@@ -0,0 +1,63 @@
+import wording from "../shared/visit-card-wording.json" with { type: "json" };
+import type { VisitServiceSummary } from "../shared/types";
+import { fieldsFor } from "./field-visit-fields";
+
+// What one field-work service's card on the Commissioner's dashboard says. The
+// server sends each service's sums and splits; which of them is the headline,
+// and what it is called, is wording, held in visit-card-wording.json.
+export type VisitCard = {
+  serviceId: number;
+  visits: number;
+  headline: { value: number; en: string; hi: string };
+  sub: { en: string; hi: string };
+  // Visits that gave no value for the headline number. Details are optional, so
+  // the card says so rather than letting the sum quietly understate.
+  missing: number;
+};
+
+type Headline = { number?: string; en: string; hi: string };
+type Sub = { split: string } | { number: string; en: string; hi: string } | { wards: true };
+type Wording = Record<string, { headline: Headline; sub: Sub }>;
+
+const WORDING = wording as Wording;
+
+// Whole numbers as they are, measurements to one decimal, Indian grouping.
+export function formatCount(value: number): string {
+  return new Intl.NumberFormat("en-IN", { maximumFractionDigits: 1 }).format(value);
+}
+
+export function visitCard(summary: VisitServiceSummary): VisitCard {
+  const words = WORDING[String(summary.serviceId)];
+  if (!words) throw new Error(`No card wording for service ${summary.serviceId}`);
+  const numberKey = words.headline.number;
+  const number = numberKey === undefined ? undefined : summary.numbers.find((n) => n.key === numberKey);
+  const headline = {
+    value: numberKey === undefined ? summary.visits : (number?.sum ?? 0),
+    en: words.headline.en,
+    hi: words.headline.hi,
+  };
+  const missing = numberKey === undefined ? 0 : summary.visits - (number?.visits ?? 0);
+  return { serviceId: summary.serviceId, visits: summary.visits, headline, sub: subLine(summary, words.sub, numberKey), missing };
+}
+
+function subLine(summary: VisitServiceSummary, sub: Sub, headlineNumber: string | undefined): { en: string; hi: string } {
+  if ("wards" in sub) {
+    const n = summary.wardsCovered;
+    return { en: `in ${n} ${n === 1 ? "ward" : "wards"}`, hi: `${n} वार्ड में` };
+  }
+  if ("number" in sub) {
+    const value = formatCount(summary.numbers.find((n) => n.key === sub.number)?.sum ?? 0);
+    return { en: `${value} ${sub.en}`, hi: `${value} ${sub.hi}` };
+  }
+  // A split: the headline number per choice where the service has one,
+  // otherwise visits per choice, in the form's own option order.
+  const field = fieldsFor(summary.serviceId).find((f) => f.key === sub.split);
+  const choice = summary.choices.find((c) => c.key === sub.split);
+  const parts = (field?.options ?? []).map((option) => {
+    const got = choice?.options.find((o) => o.value === option.value);
+    const value =
+      headlineNumber === undefined ? (got?.visits ?? 0) : (got?.numbers.find((n) => n.key === headlineNumber)?.sum ?? 0);
+    return { en: `${option.en} ${formatCount(value)}`, hi: `${option.hi} ${formatCount(value)}` };
+  });
+  return { en: parts.map((p) => p.en).join(" · "), hi: parts.map((p) => p.hi).join(" · ") };
+}
